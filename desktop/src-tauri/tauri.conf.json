{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Träumerei",
  "mainBinaryName": "traumerei",
  "version": "1.0.1",
  "identifier": "app.traumerei.desktop",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Träumerei",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 600,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "displayLanguageSelector": false
      }
    },
    "fileAssociations": [
      {
        "ext": [
          "traum"
        ],
        "name": "Träumerei room",
        "description": "Träumerei room",
        "role": "Editor",
        "mimeType": "text/plain"
      }
    ],
    "publisher": "Träumerei",
    "shortDescription": "Träumerei",
    "longDescription": "A place to finish projects: rooms of thoughts, gaps and returns.",
    "copyright": "© 2026 Träumerei"
  }
}

// Paste into Firebase console → Firestore Database → Rules, then Publish.
// Each signed-in person can read and write only their own settings, at users/{their uid}, and
// their own moments (the world's changes, batch by batch), at users/{their uid}/moments/*.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
      match /moments/{batch} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }
  }
}

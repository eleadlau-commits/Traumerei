export const css = "/* Desk: the left dock's tab. Only layout here; the look is Folio's (base.css). */\n.desk { display: grid; gap: 12px; padding: 8px 12px 16px; }\n.desk-head { display: flex; align-items: baseline; justify-content: space-between; gap: 8px; flex-wrap: wrap; }\n.desk-by { display: flex; gap: 10px; }\n.desk-by .word:not(.on) { opacity: .6; }\n.desk-floor { display: grid; gap: 10px; }\n.desk-floor-name { font-weight: 500; }\n.desk-room { display: grid; gap: 4px; }\n.desk-count { opacity: .6; }\n.desk-list { list-style: none; margin: 0; padding: 0; display: grid; gap: 2px; }\n.desk-row { display: grid; gap: 1px; width: 100%; text-align: left; padding: 4px 6px; background: none; border: 0; color: inherit; font: inherit; cursor: pointer; border-radius: 4px; }\n.desk-row:hover, .desk-row:focus-visible { background: var(--hover, rgba(127, 127, 127, .12)); }\n.desk-what { overflow-wrap: anywhere; }\n.desk-row.back .desk-what { font-weight: 500; }\n.desk-why { font-size: var(--t-small, .9em); opacity: .7; }\n";
